# 백엔드 구현 선택: local(기본, 브라우저 안에서만 동작) | http(팀 백엔드)
VITE_BACKEND=local
# 팀 백엔드 주소 (http일 때 필수). 끝에 / 없이. Swagger: <주소>/swagger-ui/index.html
# 백엔드 CORS에 등록된 주소(localhost:5173, 배포 도메인)에서만 호출돼요.
VITE_API_URL=
# 운동방 실시간 연결 주소. 비워 두면 VITE_API_URL의 /ws를 써요 (https → wss)
# VITE_WS_URL=wss://api.example.com/ws
# 운영 화면(/admin) 암호. 비워 두면 배포에서는 /admin이 닫혀요 (개발 모드에서는 암호 없이 열려요).
# VITE_ 값은 브라우저에 그대로 노출돼요. 실수로 들어오는 것만 막고, 보안 수단은 아니에요.
VITE_ADMIN_PASSWORD=
